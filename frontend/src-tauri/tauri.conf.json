{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JAE AI",
  "version": "0.0.1",
  "identifier": "com.jae.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JAE AI",
        "width": 1400,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "resources": [
      "../../build/tauri-resources/backend-runtime",
      "../../build/tauri-resources/app-template"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
