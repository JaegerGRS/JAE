# JAE AI local environment variables
JAE_AI_ENV=development
JAE_AI_DEBUG=false
JAE_AI_NODE_ID=JAE-MAIN
JAE_AI_HOST=127.0.0.1
JAE_AI_PORT=8000
JAE_AI_INFERENCE_PROVIDER=llamacpp
JAE_AI_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Optional if provider needs auth
JAE_AI_OPENAI_API_KEY=

# Backup
JAE_AI_BACKUP_ENABLED=true
# Optional: set a persistent Fernet key (base64). If omitted, key is generated locally in data/keys.
JAE_AI_BACKUP_KEY=
# Optional: set backup metadata signing key (base64 urlsafe). If omitted, key is generated locally.
JAE_AI_BACKUP_SIGNING_KEY=
JAE_AI_BACKUP_SIGNING_KEY_FILE=data/keys/backup-signing.key
JAE_AI_BACKUP_EXPORT_DIR=data/exports/backups

# Backward compatibility: JAX_AI_* variables are still accepted.
